# Generated by CMake from pyproject.toml.in - do not edit directly

[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "libjpl"
version = "@PROJECT_VERSION@"
description = "Python bindings for libjpl JPL Development Ephemeris reader"
readme = "examples/README.md"
license = {text = "MIT"}
authors = [
    {name = "Todd Carnes"}
]
classifiers = [
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
    "Topic :: Scientific/Engineering :: Astronomy",
]
requires-python = ">=3.8"
dependencies = [
    "cffi>=1.0",
]

[tool.setuptools.packages.find]
where = ["src"]
