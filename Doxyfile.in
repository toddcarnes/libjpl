PROJECT_NAME = "libjpl @PROJECT_VERSION@"
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/include" "@CMAKE_CURRENT_SOURCE_DIR@/docs/api.dox"
RECURSIVE = NO
GENERATE_HTML = YES
GENERATE_XML = YES
GENERATE_LATEX = NO
WARN_AS_ERROR = YES
