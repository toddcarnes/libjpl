if(NOT DEFINED TOOL OR NOT EXISTS "${TOOL}" OR NOT DEFINED WORK)
  message(FATAL_ERROR "test_fixture_tool.cmake needs TOOL and WORK")
endif()
set(space_dir "${WORK}/paths with spaces")
file(MAKE_DIRECTORY "${space_dir}")
# CMake file(WRITE) translates LF to CRLF on Windows. Writing explicit CRLF
# there would produce CR-CR-LF; on POSIX the explicit bytes are preserved.
if(WIN32)
  file(WRITE "${space_dir}/raw.txt" "A\nB\n")
else()
  file(WRITE "${space_dir}/raw.txt" "A\r\nB\n")
endif()
execute_process(COMMAND "${TOOL}" canon-copy "${space_dir}/raw.txt" "${space_dir}/canonical.txt"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT "${rc}" STREQUAL "0")
  message(FATAL_ERROR "canon-copy rejected CRLF: ${rc}\n${err}")
endif()
string(SHA256 expected "A\nB\n")
file(SHA256 "${space_dir}/canonical.txt" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "canon-copy changed bytes other than CRLF")
endif()
file(WRITE "${space_dir}/bare.txt" "A\rB")
execute_process(COMMAND "${TOOL}" canon-copy "${space_dir}/bare.txt" "${space_dir}/invalid.txt"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if("${rc}" STREQUAL "0" OR NOT err MATCHES "bare CR")
  message(FATAL_ERROR "canon-copy accepted bare CR or omitted diagnostic: ${rc}\n${err}")
endif()
execute_process(COMMAND "${TOOL}" canon-copy "${space_dir}/missing.txt" "${space_dir}/invalid.txt"
  RESULT_VARIABLE rc)
if("${rc}" STREQUAL "0")
  message(FATAL_ERROR "canon-copy accepted a missing input file")
endif()
execute_process(COMMAND "${TOOL}" unexpected
  RESULT_VARIABLE rc)
if("${rc}" STREQUAL "0")
  message(FATAL_ERROR "fixture tool accepted an unknown command")
endif()

function(run_tool)
  execute_process(COMMAND "${TOOL}" ${ARGN}
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "fixture mutation failed: ${ARGN}: ${result}\n${error}")
  endif()
endfunction()
foreach(source_var IN ITEMS BINARY TEXT ROWS)
  if(NOT DEFINED ${source_var} OR NOT EXISTS "${${source_var}}")
    message(FATAL_ERROR "missing fixture: ${source_var}")
  endif()
endforeach()
file(COPY_FILE "${BINARY}" "${space_dir}/flip.eph")
run_tool(flip "${space_dir}/flip.eph")
file(SHA256 "${BINARY}" original_hash)
file(SHA256 "${space_dir}/flip.eph" flipped_hash)
if(original_hash STREQUAL flipped_hash)
  message(FATAL_ERROR "flip did not change fixture binary")
endif()
run_tool(dup "${TEXT}" "${space_dir}/dup.txt" "${ROWS}" "${space_dir}/dup_rows.txt")
file(STRINGS "${space_dir}/dup.txt" duplicate_lines)
list(LENGTH duplicate_lines duplicate_count)
if(NOT duplicate_count EQUAL 121)
  message(FATAL_ERROR "duplicate fixture lost its 121-row structure")
endif()
list(GET duplicate_lines 0 first_row)
list(GET duplicate_lines 60 middle_row)
if(NOT first_row STREQUAL middle_row)
  message(FATAL_ERROR "duplicate fixture did not replace the interior rows")
endif()
file(STRINGS "${space_dir}/dup_rows.txt" duplicated_ids)
list(LENGTH duplicated_ids ids_count)
if(NOT ids_count EQUAL 121)
  message(FATAL_ERROR "duplicate fixture identity list lost rows")
endif()
foreach(i RANGE 0 119)
  list(GET duplicated_ids ${i} identity)
  if(NOT identity STREQUAL "2451544.5 12 4 5")
    message(FATAL_ERROR "duplicate fixture identity ${i} is not the first row")
  endif()
endforeach()
list(GET duplicated_ids 120 last_identity)
if(NOT last_identity STREQUAL "2455197.5 15 0 2")
  message(FATAL_ERROR "duplicate fixture lost final identity")
endif()
run_tool(retarget "${TEXT}" "${space_dir}/retarget.txt" "${ROWS}" "${space_dir}/retarget_rows.txt")
file(STRINGS "${space_dir}/retarget.txt" retargeted_lines)
list(GET retargeted_lines 60 changed_row)
if(NOT changed_row MATCHES "2453371\\.5  2  9  6")
  message(FATAL_ERROR "retarget did not alter row 61's target")
endif()
file(STRINGS "${space_dir}/retarget_rows.txt" retarget_ids)
file(STRINGS "${ROWS}" source_ids)
list(LENGTH retarget_ids ids_count)
if(NOT ids_count EQUAL 121)
  message(FATAL_ERROR "retarget fixture identity list lost rows")
endif()
foreach(i RANGE 0 120)
  list(GET retarget_ids ${i} identity)
  list(GET source_ids ${i} original_identity)
  if(i EQUAL 60)
    if(NOT identity STREQUAL "2453371.5 2 9 6")
      message(FATAL_ERROR "retarget identity 61 did not change target")
    endif()
  elseif(NOT identity STREQUAL original_identity)
    message(FATAL_ERROR "retarget changed unrelated identity ${i}")
  endif()
endforeach()
run_tool(recoord "${TEXT}" "${space_dir}/recoord.txt")
file(STRINGS "${space_dir}/recoord.txt" recoord_lines)
list(GET recoord_lines 89 changed_coord)
if(NOT changed_coord MATCHES "-0\\.02293927668434295246")
  message(FATAL_ERROR "recoord did not alter row 90's coordinate")
endif()
run_tool(crlf "${TEXT}" "${space_dir}/crlf.txt" "${ROWS}" "${space_dir}/crlf_rows.txt")
run_tool(canon-copy "${TEXT}" "${space_dir}/source.canonical")
run_tool(canon-copy "${space_dir}/crlf.txt" "${space_dir}/crlf.canonical")
file(SHA256 "${space_dir}/source.canonical" original_hash)
file(SHA256 "${space_dir}/crlf.canonical" crlf_hash)
if(NOT original_hash STREQUAL crlf_hash)
  message(FATAL_ERROR "crlf changed text contents")
endif()
