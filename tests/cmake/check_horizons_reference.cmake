if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}" OR
   NOT DEFINED REF OR NOT EXISTS "${REF}" OR
   NOT DEFINED WORK OR "${WORK}" STREQUAL "" OR
   NOT DEFINED FIXTURE_TOOL OR NOT EXISTS "${FIXTURE_TOOL}")
  message(FATAL_ERROR "Horizons integrity needs MANIFEST, REF, WORK, and FIXTURE_TOOL")
endif()

file(STRINGS "${MANIFEST}" manifest_lines)
set(expected_hash "")
set(expected_count "")
foreach(line IN LISTS manifest_lines)
  if(line MATCHES "^horizons[.]de441[.]reference[.]sha256=([0-9a-f]+)$")
    set(expected_hash "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^horizons[.]de441[.]rows=([0-9]+)$")
    set(expected_count "${CMAKE_MATCH_1}")
  endif()
endforeach()
string(LENGTH "${expected_hash}" hash_length)
if(NOT hash_length EQUAL 64 OR NOT expected_count STREQUAL "220")
  message(FATAL_ERROR "Horizons manifest needs a 64-character hash and 220 rows")
endif()

file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURE_TOOL}" canon-copy "${REF}" "${WORK}/canonical.txt"
  RESULT_VARIABLE canon_rc OUTPUT_VARIABLE canon_out ERROR_VARIABLE canon_err)
if(NOT canon_rc EQUAL 0)
  message(FATAL_ERROR "Horizons canonicalization failed: ${canon_out}\n${canon_err}")
endif()
file(SHA256 "${WORK}/canonical.txt" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Horizons hash mismatch: expected ${expected_hash}, got ${actual_hash}")
endif()

file(STRINGS "${WORK}/canonical.txt" lines)
set(expected_targets 1 2 4 5 6 7 8 9 10 301)
set(seen_markers "")
set(seen_rows "")
set(seen_target_ids "")
set(row_count 0)
foreach(line IN LISTS lines)
  string(STRIP "${line}" clean)
  if(clean STREQUAL "")
    continue()
  endif()
  if(clean MATCHES "^# target ([0-9]+): source=DE441 center=DE441$")
    list(APPEND seen_markers "${CMAKE_MATCH_1}")
    continue()
  endif()
  if(clean MATCHES "^#")
    continue()
  endif()
  string(REGEX REPLACE "[ \t]+" ";" fields "${clean}")
  list(LENGTH fields field_count)
  if(NOT field_count EQUAL 10)
    message(FATAL_ERROR "Horizons row has ${field_count} fields, expected 10: ${clean}")
  endif()
  list(GET fields 0 denum)
  list(GET fields 1 body)
  list(GET fields 2 target)
  list(GET fields 3 jd)
  if(NOT denum STREQUAL "441" OR NOT body MATCHES "^(1|2|4|5|6|7|8|9|10|11)$")
    message(FATAL_ERROR "Horizons row has invalid DENUM/body: ${clean}")
  endif()
  if(body STREQUAL "10")
    set(mapped "301")
  elseif(body STREQUAL "11")
    set(mapped "10")
  else()
    set(mapped "${body}")
  endif()
  if(NOT target STREQUAL mapped OR NOT jd MATCHES "^-?[0-9]+[.][0-9]+$")
    message(FATAL_ERROR "Horizons row has invalid target/JD: ${clean}")
  endif()
  foreach(column IN ITEMS 4 5 6 7 8 9)
    list(GET fields ${column} number)
    if(NOT number MATCHES "^-?[0-9]+[.][0-9]+$")
      message(FATAL_ERROR "Horizons row has invalid coordinate/range: ${clean}")
    endif()
  endforeach()
  list(GET fields 8 range_au)
  if(NOT range_au GREATER 0)
    message(FATAL_ERROR "Horizons range must be positive: ${clean}")
  endif()
  set(identity "${body}/${jd}")
  list(FIND seen_rows "${identity}" prior)
  if(NOT prior EQUAL -1)
    message(FATAL_ERROR "Horizons duplicate target/JD: ${identity}")
  endif()
  list(APPEND seen_rows "${identity}")
  list(APPEND seen_target_ids "${target}")
  math(EXPR row_count "${row_count} + 1")
endforeach()
if(NOT row_count EQUAL expected_count)
  message(FATAL_ERROR "Horizons rows: expected ${expected_count}, got ${row_count}")
endif()
foreach(target IN LISTS expected_targets)
  set(found 0)
  foreach(observed_target IN LISTS seen_target_ids)
    if(observed_target STREQUAL target)
      math(EXPR found "${found} + 1")
    endif()
  endforeach()
  list(FIND seen_markers "${target}" marker)
  if(NOT found EQUAL 22 OR marker EQUAL -1)
    message(FATAL_ERROR "Horizons target ${target} needs 22 rows and a DE441 source marker")
  endif()
endforeach()

if(NOT INTEGRITY_NEGATIVE)
  file(READ "${WORK}/canonical.txt" content)
  string(REPLACE "222.447119268" "222.447119269" bad "${content}")
  if(bad STREQUAL content)
    message(FATAL_ERROR "Horizons negative control lacks Moon anchor")
  endif()
  file(WRITE "${WORK}/mutated.txt" "${bad}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DMANIFEST=${MANIFEST}" "-DREF=${WORK}/mutated.txt"
    "-DWORK=${WORK}/negative" "-DFIXTURE_TOOL=${FIXTURE_TOOL}"
    -DINTEGRITY_NEGATIVE=YES -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE negative_rc OUTPUT_VARIABLE negative_out ERROR_VARIABLE negative_err)
  if(negative_rc EQUAL 0 OR NOT negative_err MATCHES "hash mismatch")
    message(FATAL_ERROR "Horizons negative control did not detect changed coordinate:\n${negative_out}\n${negative_err}")
  endif()
  string(REPLACE "0.0321755" "0.0321756" changed_rate "${content}")
  if(changed_rate STREQUAL content)
    message(FATAL_ERROR "Horizons negative control lacks Moon deldot anchor")
  endif()
  file(WRITE "${WORK}/changed_rate.txt" "${changed_rate}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DMANIFEST=${MANIFEST}" "-DREF=${WORK}/changed_rate.txt"
    "-DWORK=${WORK}/negative_rate" "-DFIXTURE_TOOL=${FIXTURE_TOOL}"
    -DINTEGRITY_NEGATIVE=YES -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE rate_rc OUTPUT_VARIABLE rate_out ERROR_VARIABLE rate_err)
  if(rate_rc EQUAL 0 OR NOT rate_err MATCHES "hash mismatch")
    message(FATAL_ERROR "Horizons negative control did not detect changed range-rate:\n${rate_out}\n${rate_err}")
  endif()
endif()
message(STATUS "libjpl: ${row_count} Horizons reference rows verified")
