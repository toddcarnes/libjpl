#ifndef LIBJPL_EXPORT_H
#define LIBJPL_EXPORT_H
/* Generated by CMake configure_file; do not edit directly.
 * JPL_BUILDING_SHARED is defined via target_compile_definitions(jpl_shared PRIVATE ...). */
#if defined(JPL_BUILDING_SHARED)
#  if defined(_WIN32)
#    define JPL_API __declspec(dllexport)
#  else
#    define JPL_API __attribute__((visibility("default")))
#  endif
#else
#  define JPL_API
#endif
#endif